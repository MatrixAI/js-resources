{
  "name": "@matrixai/resources",
  "version": "3.0.0",
  "author": "Roger Qiu",
  "description": "Resource context management",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MatrixAI/js-resources.git"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./functions": {
      "types": "./dist/functions/index.d.ts",
      "import": "./dist/functions/index.js"
    },
    "./decorators": {
      "types": "./dist/decorators/index.d.ts",
      "import": "./dist/decorators/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./*": "./dist/*"
  },
  "imports": {
    "#*": "./dist/*"
  },
  "scripts": {
    "prepare": "tsc -p ./tsconfig.build.json",
    "build": "node ./scripts/build.mjs",
    "postversion": "npm install --package-lock-only --ignore-scripts --silent",
    "test": "node ./scripts/test.mjs",
    "typecheck": "tsc -p ./tsconfig.json",
    "lint": "matrixai-lint --check",
    "lintfix": "matrixai-lint --fix"
  },
  "dependencies": {
    "@matrixai/contexts": "git+ssh://git@github.com/MatrixAI/js-contexts.git#v4.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@matrixai/async-init": "git+ssh://git@github.com/MatrixAI/js-async-init.git#v5.0.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "!dist/tsbuildinfo"]
}
