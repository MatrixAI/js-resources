{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/tsbuildinfo",
    "incremental": true,
    "sourceMap": true,
    "declaration": true,
    "allowJs": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022", "ESNext.Disposable"],
    "paths": {
      "@matrixai/resources": ["./dist/index.d.ts"],
      "@matrixai/resources/functions": ["./dist/functions/index.d.ts"],
      "@matrixai/resources/decorators": ["./dist/decorators/index.d.ts"],
      "#*": ["./src/*"]
    },
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "./src/**/*",
    "./src/**/*.json",
    "./tests/**/*.test.ts",
    "./tests/**/*.test-d.ts",
    "./vitest.config.mts"
  ]
}
